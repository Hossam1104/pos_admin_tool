/* Premium Dark Theme for POS Admin Tool */
QMainWindow, QWidget#centralWidget {
    background-color: #0A0A0A;
    color: #FFFFFF;
}

QGroupBox {
    font-weight: bold;
    border: 1px solid #333333;
    border-radius: 8px;
    margin-top: 20px;
    padding-top: 15px;
    background-color: #161616;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #0078D4;
}

QPushButton {
    background-color: #0078D4;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #106EBE;
}

QPushButton:pressed {
    background-color: #005A9E;
}

QLineEdit, QTextEdit, QComboBox {
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 5px;
    background-color: #202020;
    color: #FFFFFF;
}

QScrollArea {
    border: none;
    background-color: #0A0A0A;
}

QScrollBar:vertical {
    border: none;
    background: #0A0A0A;
    width: 12px;
}

QScrollBar::handle:vertical {
    background: #444444;
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: #555555;
}

QMessageBox {
    background-color: #161616;
    color: #FFFFFF;
}

QMessageBox QLabel {
    color: #FFFFFF;
    font-size: 14px;
}

QMessageBox QPushButton {
    min-width: 80px;
    min-height: 25px;
    background-color: #0078D4;
}